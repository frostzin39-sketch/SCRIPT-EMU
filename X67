# ==========================================
# FUNÇÃO INTELIGENTE: Tenta root, senão roda comum
# ==========================================
executar_comando() {
    local cmd="$1"
    if command -v su &> /dev/null && su -c "id" &> /dev/null; then
        su -c "$cmd" 2>/dev/null
    else
        eval "$cmd" 2>/dev/null
    fi
}

