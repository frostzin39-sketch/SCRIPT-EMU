        "setprop ro.input.debounce_delay 0" "setprop ro.input.filter_noise 0" "setprop ro.input.touch_boost 1"
        "setprop ro.input.response_speed 150" "setprop debug.touch.device 0" "setprop debug.touch.debounce 0"
        "setprop touch.filter.level 0" "setprop touch.device.type touchScreen" "setprop touch.orientationAware 1"
        "setprop touch.size.calibration geometric" "setprop touch.pressure.calibration physical" "setprop touch.distance.calibration none"
        "setprop touch.coverage.calibration none" "setprop touch.orientation.calibration none" "setprop touch.distance.scale 0"
        "setprop touch.size.scale 0" "setprop touch.pressure.scale 0.001" "setprop touch.gesture.smooth 1"

        # Bloco Final de Estabilização e Latência Zero (71-100)
        "setprop touch.sampling_rate 240" "setprop vendor.touch.sample_rate 240" "setprop touch.response_boost 1"
        "setprop touch.latency_reduction 1" "setprop persist.sys.touch_boost 1" "setprop vendor.touch.boost 1"
        "setprop vendor.touch.lat_reduction 1" "setprop ro.input.multitouch_timeout 30" "setprop ro.input.capture_delay 0"
        "setprop ro.input.debounce_delay 0" "setprop ro.input.filter_noise 0" "setprop touch.sampling_rate 240"
        "settings put system vibrate_input_enabled 0" "settings put system haptic_feedback_enabled 0"
        "settings put system keyboard_vibration_enabled 0" "settings put system sound_effects_enabled 0"
        "input keyevent 26" "input keyevent 82"
    )

    for cmd in "${c[@]}"; do
        executar_comando "$cmd"
    done
}

