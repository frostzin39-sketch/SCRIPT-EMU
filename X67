        "setprop touch.size.calibration geometric" "setprop touch.pressure.calibration physical" "setprop touch.distance.calibration none"
        "setprop touch.coverage.calibration none" "setprop touch.orientation.calibration none" "setprop touch.distance.scale 0"

        # Bloco de Reforço de Touch e Amostragem (31-70)
        "setprop touch.size.scale 0" "setprop touch.pressure.scale 0.001" "setprop touch.gesture.smooth 1"
        "setprop touch.sampling_rate 240" "setprop vendor.touch.sample_rate 240" "setprop touch.response_boost 1"
