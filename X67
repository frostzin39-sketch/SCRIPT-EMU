    echo -e "\n${VERMELHO}Enviando comandos para calibração de toque e taxa de amostragem a 240Hz...${RESET}"

    local c=(
        # Bloco de Calibração Inicial (1-30)
        "settings put secure long_press_timeout 200" "settings put system pointer_speed 1"
        "settings put secure touch_exploration_enabled 0" "settings put system touch_sensibility_enabled 1"
